  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Achievement Table_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 07465f9b54999484eb067aad828aa1d9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 19028500480
    m_Localized: Recibiste "<rainb><b>{0}</b></>",
    m_Metadata:
      m_Items: []
  - m_Id: 21108875264
    m_Localized: "lo encontrar\xE1s en tu casa."
    m_Metadata:
      m_Items: []
  - m_Id: 23034060800
    m_Localized: "\xA1Tu <incr><rainb><b>{0}</b></>...\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 94135902208
    m_Localized: \nha <wiggle>mejorado!</>
    m_Metadata:
      m_Items: []
  - m_Id: 770270289920
    m_Localized: "<bounce><b>{0}</b></> particip\xF3 en activaci\xF3n para reponer
      las \xE1reas verdes <shake>\xA1Yupi!</>"
    m_Metadata:
      m_Items: []
  - m_Id: 773428600832
    m_Localized: "<bounce><b>{0}</b></> expuso en su escuela sobre las consecuencias
      ambientales de la miner\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 775995514880
    m_Localized: "<bounce><b>{0}</b></> particip\xF3 activamente en un evento de
      <b>Gotita Verde</b>, partido pol\xEDtico local con enfoque medioambiental.
      <shake>\xA1Hurra!</>"
    m_Metadata:
      m_Items: []
  - m_Id: 1462951206912
    m_Localized: "<bounce><b>{0}</b></> se uni\xF3 a una protesta pac\xEDfica en
      contra de la contaminaci\xF3n minera del r\xEDo."
    m_Metadata:
      m_Items: []
  - m_Id: 778239467520
    m_Localized: "<bounce><b>{0}</b></> utiliz\xF3 un porcentaje de los fondos de
      su partido en su imagen <shake>\xA1Eso es tener estilo!</>"
    m_Metadata:
      m_Items: []
  - m_Id: 782496686080
    m_Localized: "<bounce><b>{0}</b></> complet\xF3 un curso de capacitaci\xF3n sobre
      derecho forestal."
    m_Metadata:
      m_Items: []
  - m_Id: 1470740029440
    m_Localized: "<bounce><b>{0}</b></> se uni\xF3 de forma oficial al partido de
      la Gotita Verde. <shake>\xA1Ahora puede postular a las elecciones internas!</>"
    m_Metadata:
      m_Items: []
  - m_Id: 780349202432
    m_Localized: "\xA1La nota de <bounce><b>{0}</b></> en el periodico mural ha causado
      revuelo! <swing>\xA1Sigue as\xED!</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 1354629111808
    m_Localized: "<bounce><b>{0}</b></> utiliz\xF3 sus conexiones con otros partidos
      para \u201Ccompartir apoyo\u201D en las pr\xF3ximas elecciones."
    m_Metadata:
      m_Items: []
  - m_Id: 1356935979008
    m_Localized: "<bounce><b>{0}</b></> particip\xF3 en su primera marcha repartiendo
      afiches hechos a mano."
    m_Metadata:
      m_Items: []
  - m_Id: 1351743430656
    m_Localized: "Alguien del partido pol\xEDtico Gotita Verde conf\xEDo en <bounce><b>{0}</b></>
      para entregar unos documentos sellados a una entidad petrolera."
    m_Metadata:
      m_Items: []
  - m_Id: 1472497442816
    m_Localized: "<bounce><b>{0}</b></> consigui\xF3 un reloj nuevo. Tienes tus sospechas,
      pero <bounce><b>{0}</b></> no te dijo nada m\xE1s."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
